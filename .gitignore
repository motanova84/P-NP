# ===============================
#  P–NP Project — Unified .gitignore
#  Combines Python + Lean + Build + OS
# ===============================

# ---------- PYTHON ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- LEAN ----------
/build/
/lake-packages/
/.lake/
/*.olean
/*.trace

# ---------- TEST / RESULTS ----------
results/
!results/.gitkeep
*.log
*.csv
*.png

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- CI / CACHE ----------
.cache/
__pypackages__/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.pyre/
lake-manifest.json

# Generated examples
tree_decomposition_example.png
dicotomia_computacional.png

# Echo-QCAL runtime data
pnp/echo_qcal/data/logs/*.json
pnp/echo_qcal/data/firmas/*
!pnp/echo_qcal/data/firmas/.gitkeep
pnp/echo_qcal/data/config/*
!pnp/echo_qcal/data/config/.gitkeep
echo_qcal_logs/
echo_qcal_config/

# Generated QCAL integration files
.qcal_symbiosis.md
coinqcal/

# Generated paper
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.out
